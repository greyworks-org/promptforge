{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptForge Local",
  "version": "0.1.0",
  "identifier": "com.promptforge.local",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
